13. 🏠 Home Folders for HR and Sales Users
📂 Path: \\rev.local\Home\%UserName% mapped to H:\
💻 PowerShell Automation
powershell
# HR Users
$hrUsers = Get-ADUser -Filter * -SearchBase "OU=HR,DC=rev,DC=local"
foreach ($user in $hrUsers) {
    $homePath = "\\rev.local\Home\" + $user.SamAccountName
    New-Item -Path $homePath -ItemType Directory -Force
    Set-ADUser $user -HomeDrive "H:" -HomeDirectory $homePath
}

# Sales Users
$salesUsers = Get-ADUser -Filter * -SearchBase "OU=Sales,DC=rev,DC=local"
foreach ($user in $salesUsers) {
    $homePath = "\\rev.local\Home\" + $user.SamAccountName
    New-Item -Path $homePath -ItemType Directory -Force
    Set-ADUser $user -HomeDrive "H:" -HomeDirectory $homePath
}





# Create OUs
New-ADOrganizationalUnit -Name "HR" -Path "DC=rev,DC=local"
New-ADOrganizationalUnit -Name "Sales" -Path "DC=rev,DC=local"

# Create HR users
New-ADUser -Name "hr_user1" -GivenName "HR" -Surname "User1" `
    -SamAccountName hr_user1 -UserPrincipalName hr_user1@rev.local `
    -Path "OU=HR,DC=rev,DC=local" `
    -AccountPassword (ConvertTo-SecureString "P@ssw0rd" -AsPlainText -Force) `
    -Enabled $true

New-ADUser -Name "hr_manager" -GivenName "HR" -Surname "Manager" `
    -SamAccountName hr_manager -UserPrincipalName hr_manager@rev.local `
    -Path "OU=HR,DC=rev,DC=local" `
    -AccountPassword (ConvertTo-SecureString "P@ssw0rd" -AsPlainText -Force) `
    -Enabled $true

# Create HR group and add members
